# Copy to Tools/signing.env, which .gitignore excludes, and fill in.
# Without this file the bundle is ad-hoc signed, which is fine locally and
# rejected by Gatekeeper on anyone else's Mac.

# The full certificate name, from: security find-identity -v -p codesigning
# Needs a paid Apple Developer account.
MAC_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID1234)"

# Notarization. Omit these three to sign without notarizing, which still leaves
# a Gatekeeper warning, so it is rarely what you want.
APPLE_ID="you@example.com"
APPLE_TEAM_ID="TEAMID1234"

# Not your Apple account password. Generate one at appleid.apple.com under
# Sign-In and Security, App-Specific Passwords.
APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"
