<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ ignores android:allowBackup for these two paths, so the exclusions are
     repeated here. Pairing state is device-specific: the HMAC key cannot leave the
     keystore, so a token restored onto another device would only fail to sign. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
